<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090d16"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ScreenCast Pro"
        android:textColor="#38bdf8"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Truyền Màn Hình Không Dây 60 FPS"
        android:textColor="#94a3b8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="36dp"
        android:background="#1e293b"
        android:gravity="center"
        android:padding="20dp"
        android:text="Sẵn sàng kết nối.\nHãy nhấn Quét Mã QR để bắt đầu."
        android:textColor="#f8fafc"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnScanQR"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#38bdf8"
        android:text="📷 Quét Mã QR Máy Tính"
        android:textColor="#0f172a"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnStopCast"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#ef4444"
        android:enabled="false"
        android:text="⏹️ Dừng Chiếu Màn Hình"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
